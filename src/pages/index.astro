---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts")).sort(
  (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
);
const homePath = getRelativeLocaleUrl(locale, "");
const dateFormat = new Intl.DateTimeFormat("sv-SE", {
  timeZone: config.site.timezone,
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
});
const entries = posts.slice(0, config.posts.perIndex).map(post => ({
  post,
  date: dateFormat.format(post.data.pubDatetime),
}));
const years = [...new Set(entries.map(entry => entry.date.slice(0, 4)))];
---

<Layout>
  <Header />
  <main id="main-content" data-home-path={homePath} class="app-layout home">
    <div class="intro">
      <h1>学习笔记</h1>
      <p>这里放我的学习笔记，方便以后查。</p>
    </div>
    {
      years.map(year => (
        <section class="year-group" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <ul>
            {entries
              .filter(entry => entry.date.startsWith(year))
              .map(({ post, date }) => (
                <li>
                  <time
                    datetime={post.data.pubDatetime.toISOString()}
                    title={date}
                  >
                    {date.slice(5)}
                  </time>
                  <a href={getPostUrl(post.id, post.filePath, locale)}>
                    {post.data.title}
                  </a>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
    {entries.length === 0 && <p class="empty">还没有文章。</p>}
    <a class="all-posts" href={getRelativeLocaleUrl(locale, "posts")}
      >全部文章</a
    >
  </main>
  <Footer noMarginTop />
</Layout>

<style>
  .home {
    padding-top: 3.25rem;
    padding-bottom: 4rem;
  }
  .intro {
    margin-bottom: 2.75rem;
  }
  h1 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .intro p {
    margin-top: 0.65rem;
    font-size: 0.95rem;
    color: var(--muted-foreground);
  }
  .year-group + .year-group {
    margin-top: 2rem;
  }
  h2 {
    margin-bottom: 0.9rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--muted-foreground);
  }
  li {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    margin-block: 0.9rem;
  }
  time {
    color: var(--muted-foreground);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  li a {
    font-size: 1rem;
    line-height: 1.8;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.3em;
    overflow-wrap: anywhere;
  }
  li a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  .all-posts {
    display: inline-block;
    margin-top: 2.3rem;
    color: var(--muted-foreground);
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .all-posts:hover {
    color: var(--accent);
  }
  .empty {
    color: var(--muted-foreground);
  }
  @media (max-width: 639px) {
    .home {
      padding-top: 2rem;
      padding-bottom: 3rem;
    }
    .intro {
      margin-bottom: 2rem;
    }
    li {
      column-gap: 0.6rem;
      grid-template-columns: 3rem minmax(0, 1fr);
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector<HTMLElement>("#main-content");
    if (main?.dataset.homePath)
      sessionStorage.setItem("backUrl", main.dataset.homePath);
  });
</script>
